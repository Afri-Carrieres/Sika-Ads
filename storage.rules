rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Fonction utilitaire pour vérifier l'authentification
    function isSignedIn() {
      return request.auth != null;
    }

    // Dossier des visuels de campagnes
    match /campaign_visuals/{allPaths=**} {
      // Tout le monde peut voir les visuels des campagnes
      allow read: if true;
      // Seuls les utilisateurs connectés peuvent uploader (Admin ou Annonceur)
      allow write: if isSignedIn();
    }

    // Dossier des preuves de partage
    match /proofs/{userId}/{allPaths=**} {
      // L'utilisateur peut lire/écrire ses propres preuves
      // Les admins/modérateurs peuvent tout lire (pour validation)
      allow read: if isSignedIn(); 
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Dossier des photos de profil
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Règle par défaut : accès restreint pour le reste
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}
